---
// A table cell's text: plain, or with one linked span in the middle (src/data/sessions.ts).
import type { Link } from '../data/sessions';

interface Props {
  value: string | { before: string; link: Link; after?: string };
}
const { value } = Astro.props;
---
{typeof value === 'string' ? value : <>{value.before}<a href={value.link.href}>{value.link.text}</a>{value.after}</>}
