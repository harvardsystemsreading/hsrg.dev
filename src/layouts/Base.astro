---
// Document shell for the markdown pages in src/pages/: a one-line header and a single reading column.
import '../styles/style.css';

interface Props {
  frontmatter: { title: string; description: string };
}
const { title, description } = Astro.props.frontmatter;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" href="/assets/logo-old.png">
</head>
<body>
  <header>
    <p class="title"><a href="/">hsrg.dev</a></p>
  </header>
  <main>
    <slot />
  </main>
</body>
</html>
